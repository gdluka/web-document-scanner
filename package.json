{
  "name": "a-bobs-scan",
  "version": "1.0.0",
  "private": true,
  "description": "Browser document scanner with live edges, burst fusion and single-pass geometric correction.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "npm run dev",
    "build:workers": "node scripts/build-workers.mjs",
    "build": "npm run typecheck && npm run build:workers && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "solid-js": "1.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  }
}
